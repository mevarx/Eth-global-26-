# Copy to .env.local for the web app; never commit real values.
APP_ORIGIN=http://127.0.0.1:3001
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3001
SESSION_SECRET=
DATABASE_PATH=./data/tool-city.sqlite
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# Arkiv access keys are public endpoint access controls, not wallet credentials.
# Server-side reconciliation reads this only from .env.local; never put it in browser output.
ARKIV_ACCESS_KEY=
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_MODEL_ID=0gm-1.0-35b-a3b
INFERENCE_TIMEOUT_MS=60000
PAYMENT_CONFIRMATIONS=3
NEXT_PUBLIC_ENABLE_DEV_FIXTURES=false
# Deploy tooling reads a separate gitignored .env, not required by the running app.
DEPLOYER_PRIVATE_KEY=
MERCHANT_ADDRESS=
CHECKOUT_ADDRESS=
# BriefMint compilation remains unavailable until every quota field is configured.
# These limits spend promotional/operator compute credits, not Whitechain funds.
# Keep the allowlist empty until the operator explicitly chooses existing demo wallets.
BRIEFMINT_ALLOWED_WALLETS=
BRIEFMINT_COMPILATIONS_PER_WALLET=
BRIEFMINT_GLOBAL_DISPATCH_LIMIT=
BRIEFMINT_QUOTA_WINDOW_ID=
BRIEFMINT_QUOTA_WINDOW_END=
# Legacy Vite checkout/reference configuration only; the current Next city uses same-origin APIs.
# Never put 0G or session secrets in VITE_* or NEXT_PUBLIC_* variables.
VITE_ARKIV_ACCESS_KEY=
